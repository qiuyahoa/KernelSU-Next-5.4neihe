# KernelSU Action -- build profile for Xiaomi haydn (Redmi K40 Pro, sm8350, 5.4 non-GKI)
CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/psndna88/AGNi_pureMIUI
KERNEL_SOURCE_BRANCH=AGNi_haydn_MIUI_ST
KERNEL_CONFIG=agni_haydn_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld CROSS_COMPILE_COMPAT=/home/runner/work/KernelSU_Action/KernelSU_Action/kernel_workspace/gcc-32/bin/arm-linux-androideabi- AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump READELF=llvm-readelf OBJSIZE=llvm-size STRIP=llvm-strip LLVM_NM=llvm-nm EXTRA_WARNINGS=-Wno-switch-enum
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

CLANG_BRANCH=main-kernel-build-2024
CLANG_VERSION=r510928

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

USE_LLVM=false

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# backslashxx/KernelSU is the only upstream-compliant driver that still ships
# non-GKI support (kernel 3.0 ~ 5.4+) while keeping the *current* supercall ABI:
# its uapi/ headers are byte-identical to tiann/KernelSU @5220ace8 and it
# advertises KSU_VERSION 32715 / uapi 6, which is what the manager APK
# v3.3.1-31-g5220ace8 requires (MINIMAL_SUPPORTED_KERNEL = 32513, exact uapi
# match). tiann/KernelSU >= v1.0 cannot compile on 5.4 at all: its
# selinux/rules.c + sepolicy.c + feature/selinux_hide.c are written against the
# `struct selinux_policy` split introduced in 5.10, and 5.4 keeps the policy
# inline in `struct selinux_ss`. backslashxx carries the `selinux_state.ss`
# in-place policy edit path.
KSU_VARIANT=backslashxx
KSU_REF=master
# 'none' = do not run patches/legacy_ksu_hooks.sh. That script injects the
# v0.9.5-era ksu_handle_execveat/faccessat/stat/vfs_read calls into fs/*.c by
# sed; backslashxx hooks those at runtime instead (arm64 branch-link inline
# patching + LSM), so applying the source patches would both miss the symbols
# and fight the tree's own call sites.
KSU_HOOK_MODE=none

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

ENABLE_SUSFS=false  # AGNi tree already contains susfs v1.5.x kernel-side (fs/susfs.c); external patch would conflict
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true
# CONFIG_BPF_PRELOAD=n        run11: otherwise the build dies on
#                             "Could not find incbin file kernel/bpf/preload/bpf_preload_umd"
# CONFIG_KSU_SUSFS*=n         AGNi ships SUSFS kernel-side (fs/susfs.c + hooks in
#                             fs/readdir.c, fs/namespace.c, fs/devpts/inode.c,
#                             fs/stat.c, fs/open.c, fs/exec.c, kernel/reboot.c,
#                             drivers/input/input.c). Those hooks call SukiSU-only
#                             symbols (ksu_handle_vfs_fstat, susfs_is_current_ksu_domain,
#                             non-static try_umount, ksu_input_hook_key_false) that
#                             backslashxx does not provide, so SUSFS has to stay off
#                             until a separate bridge is written.
# CONFIG_KSU_HACK_ARM64_BRANCH_LINK=y  backslashxx's recommended hook for 4.19+:
#                             inline BL callsite rewriting into do_faccessat /
#                             vfs_statx / __do_execve_file, with the syscall-table
#                             hook kept as a fallback. Needs KALLSYMS (AGNi has
#                             KALLSYMS_ALL=y). Kconfig makes this mutually exclusive
#                             with CONFIG_KSU_TAMPER_SYSCALL_TABLE.
EXTRA_DEFCONFIG:CONFIG_BPF_PRELOAD=n CONFIG_KSU_HACK_ARM64_BRANCH_LINK=y CONFIG_KSU_LSM_SECURITY_HOOKS=y CONFIG_KSU_SUSFS=n CONFIG_KSU_SUSFS_SUS_PATH=n CONFIG_KSU_SUSFS_SUS_MOUNT=n CONFIG_KSU_SUSFS_SUS_KSTAT=n CONFIG_KSU_SUSFS_TRY_UMOUNT=n CONFIG_KSU_SUSFS_SPOOF_UNAME=n CONFIG_KSU_SUSFS_ENABLE_LOG=n CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=n CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=n CONFIG_KSU_SUSFS_OPEN_REDIRECT=n CONFIG_KSU_SUSFS_SUS_MAP=n

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
